{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the CC Cockpit main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-badge-count",
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text"
  ]
}
